{
  "name": "@theluckystrike/webext-offscreen",
  "version": "1.0.0",
  "description": "Typed offscreen document creation and messaging for Chrome MV3 extensions — DOM parsing, audio, canvas, and more. Part of @zovo/webext.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/webext-offscreen.git"
  },
  "homepage": "https://github.com/theluckystrike/webext-offscreen#readme",
  "bugs": {
    "url": "https://github.com/theluckystrike/webext-offscreen/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "keywords": [
    "chrome-extension",
    "offscreen",
    "webextension",
    "typescript",
    "chrome",
    "mv3",
    "offscreen-document",
    "zovo-webext"
  ],
  "author": "theluckystrike",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
