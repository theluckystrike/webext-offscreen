{
  "name": "webext-offscreen",
  "version": "1.0.0",
  "description": "Typed offscreen document creation and messaging for Chrome extensions",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/webext-offscreen.git"
  },
  "homepage": "https://github.com/theluckystrike/webext-offscreen#readme",
  "bugs": {
    "url": "https://github.com/theluckystrike/webext-offscreen/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "keywords": ["chrome-extension", "offscreen", "webextension", "typescript"],
  "author": "theluckystrike",
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
